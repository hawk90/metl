 1085|       |          e.state_ = detail::expected_state::error;
 1086|       |          throw;
 1087|       |        }
 1088|       |      }
 1089|    576|#endif
 1090|    576|      v.value_ptr()->~T();
 1091|    576|      v.construct_error(static_cast<E&&>(tmp));
 1092|       |    } else {
