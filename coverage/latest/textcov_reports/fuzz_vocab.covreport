 1439|    548|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1440|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1441|       |    // rollback is always possible; with two throwing moves the last step could
 1442|       |    // fail after both originals are gone, leaving a destroyed member under a
 1443|       |    // stale discriminant. std::expected::swap has the same
 1444|       |    // requirement.
 1445|    548|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1446|    548|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1447|       |    // Both read as switching until both members are in place again.
 1448|    548|    v.state_ = detail::expected_state::switching;
 1449|    548|    e.state_ = detail::expected_state::switching;
 1450|    548|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
 1451|    548|      E tmp(static_cast<E&&>(*e.error_ptr()));
 1452|    548|      e.error_ptr()->~E();
 1453|       |      // The rollback exists for the case where T's move CAN throw. In the
 1454|       |      // instantiation where it cannot, this function is noexcept (see the
 1455|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
 1456|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
 1457|       |      // so with `if constexpr` compiles the handler only where it can run,
 1458|       |      // which is what the code already meant.
 1459|       |#if METL_NO_EXCEPTIONS
 1460|       |      e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1461|       |#else
 1462|    548|      if constexpr (std::is_nothrow_move_constructible_v<T>) {
 1463|    548|        e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1464|       |      } else {
 1465|       |        try {
 1466|       |          e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1467|       |        } catch (...) {
 1468|       |          e.construct_error(static_cast<E&&>(tmp));  // restore e
 1469|       |          v.state_ = detail::expected_state::value;
 1470|       |          e.state_ = detail::expected_state::error;
 1471|       |          throw;
 1472|       |        }
 1473|       |      }
 1474|    548|#endif
 1475|    548|      v.value_ptr()->~T();
 1476|    548|      v.construct_error(static_cast<E&&>(tmp));
 1477|       |    } else {
 1478|       |      T tmp(static_cast<T&&>(*v.value_ptr()));
 1479|       |      v.value_ptr()->~T();
 1480|       |#if !METL_NO_EXCEPTIONS
 1481|       |      try {
 1482|       |#endif
 1483|       |        v.construct_error(static_cast<E&&>(*e.error_ptr()));
 1484|       |#if !METL_NO_EXCEPTIONS
 1485|       |      } catch (...) {
 1486|       |        v.construct_value(static_cast<T&&>(tmp));  // restore v
 1487|       |        v.state_ = detail::expected_state::value;
 1488|       |        e.state_ = detail::expected_state::error;
 1489|       |        throw;
 1490|       |      }
 1491|       |#endif
 1492|       |      e.error_ptr()->~E();
 1493|       |      e.construct_value(static_cast<T&&>(tmp));
 1494|       |    }
