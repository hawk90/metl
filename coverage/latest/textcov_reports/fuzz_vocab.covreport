fuzz_vocab.cpp:_ZN4metl8expectedIN12_GLOBAL__N_17payloadENS1_13other_payloadEE15reinit_as_valueIJS2_EEEvDpOT_:
  784|    203|  void reinit_as_value(Args&&... args) {
  785|    203|    if constexpr (std::is_move_constructible_v<T>) {
  786|       |      // Build the new value BEFORE touching the old member: `args` may refer
  787|       |      // into it (`e = e.error().fallback`), and destroying first read a dead
  788|       |      // object (variant's converting assignment had the same bug).
  789|       |      // A throw here leaves the state untouched.
  790|    203|      T incoming(std::forward<Args>(args)...);
  791|    203|      commit_value(static_cast<T&&>(incoming));
  792|       |    } else if constexpr (std::is_nothrow_constructible_v<T, Args&&...>) {
  793|       |      // A non-movable T cannot be built aside; aliasing the old member is a
  794|       |      // precondition violation here, as it is for std::expected.
  795|       |      error_ptr()->~E();
  796|       |      construct_value(std::forward<Args>(args)...);
  797|       |    } else {
  798|       |#if METL_NO_EXCEPTIONS
  799|       |      error_ptr()->~E();
  800|       |      construct_value(std::forward<Args>(args)...);
  801|       |#else
  802|       |      E backup(static_cast<E&&>(*error_ptr()));
  803|       |      error_ptr()->~E();
  804|       |      try {
  805|       |        construct_value(std::forward<Args>(args)...);
  806|       |      } catch (...) {
  807|       |        construct_error(static_cast<E&&>(backup));  // restore the previous state
  808|       |        throw;
  809|       |      }
  810|       |#endif
  811|       |    }
  812|    203|    has_value_ = true;
  813|    203|  }
