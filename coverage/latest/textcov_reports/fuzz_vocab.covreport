  220|       |    ::new (static_cast<void*>(slot)) U(std::forward<Args>(args)...);
  221|       |    state = settled;
  222|    282|  } else if constexpr (std::is_nothrow_move_constructible_v<U> || METL_NO_EXCEPTIONS) {
  223|       |    // Only the constructor can throw, and it runs while the old value is intact.
  224|    282|    U incoming(std::forward<Args>(args)...);
  225|    282|    state = expected_state::switching;
