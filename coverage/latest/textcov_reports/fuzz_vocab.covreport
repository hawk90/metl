 1054|    569|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1055|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1056|       |    // rollback is always possible; with two throwing moves the last step could
 1057|       |    // fail after both originals are gone, leaving a destroyed member under a
 1058|       |    // stale discriminant. std::expected::swap has the same
 1059|       |    // requirement.
 1060|    569|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1061|    569|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1062|       |    // Both read as switching until both members are in place again.
 1063|    569|    v.state_ = detail::expected_state::switching;
 1064|    569|    e.state_ = detail::expected_state::switching;
 1065|    569|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
