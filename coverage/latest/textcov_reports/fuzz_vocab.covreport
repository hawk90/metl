  213|    313|void replace_live(U* slot, expected_state& state, expected_state settled, Args&&... args) {
  214|       |  if constexpr (!std::is_move_constructible_v<U>) {
  215|       |    // Nothing can be built aside or set aside for a rollback -- std::expected::
  216|       |    // emplace rejects such a U outright; METL keeps accepting it, without the
  217|       |    // aliasing support or the guarantee.
  218|       |    state = expected_state::switching;
  219|       |    slot->~U();
  220|       |    ::new (static_cast<void*>(slot)) U(std::forward<Args>(args)...);
  221|       |    state = settled;
  222|    313|  } else if constexpr (std::is_nothrow_move_constructible_v<U> || METL_NO_EXCEPTIONS) {
  223|       |    // Only the constructor can throw, and it runs while the old value is intact.
  224|    313|    U incoming(std::forward<Args>(args)...);
  225|    313|    state = expected_state::switching;
  226|    313|    slot->~U();
  227|    313|    ::new (static_cast<void*>(slot)) U(static_cast<U&&>(incoming));
  228|    313|    state = settled;
  229|       |  }
  230|       |#if !METL_NO_EXCEPTIONS
  231|       |  else {
  232|       |    // The final move can throw: keep the old value in `backup` to move back.
  233|       |    U incoming(std::forward<Args>(args)...);
  234|       |    U backup(static_cast<U&&>(*slot));
  235|       |    state = expected_state::switching;
  236|       |    slot->~U();
  237|       |    try {
  238|       |      ::new (static_cast<void*>(slot)) U(static_cast<U&&>(incoming));
  239|       |    } catch (...) {
  240|       |      ::new (static_cast<void*>(slot)) U(static_cast<U&&>(backup));
  241|       |      state = settled;
  242|       |      throw;
  243|       |    }
  244|       |    state = settled;
  245|       |  }
  246|    313|#endif
  247|    313|}
