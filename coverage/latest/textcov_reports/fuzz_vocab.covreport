  819|    399|      error_ptr()->~E();
  820|    399|      construct_value(std::move(incoming));
  821|       |    } else {
  822|       |#if METL_NO_EXCEPTIONS
  823|       |      error_ptr()->~E();
  824|       |      construct_value(std::move(incoming));
  825|       |#else
  826|       |      E backup(static_cast<E&&>(*error_ptr()));
  827|       |      error_ptr()->~E();
  828|       |      try {
  829|       |        construct_value(std::move(incoming));
  830|       |      } catch (...) {
  831|       |        construct_error(static_cast<E&&>(backup));
  832|       |        throw;
  833|       |      }
  834|       |#endif
