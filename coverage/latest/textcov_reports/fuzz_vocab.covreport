 1054|    592|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1055|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1056|       |    // rollback is always possible; with two throwing moves the last step could
 1057|       |    // fail after both originals are gone, leaving a destroyed member under a
 1058|       |    // stale discriminant. std::expected::swap has the same
 1059|       |    // requirement.
 1060|    592|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1061|    592|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1062|       |    // Both read as switching until both members are in place again.
 1063|    592|    v.state_ = detail::expected_state::switching;
 1064|    592|    e.state_ = detail::expected_state::switching;
 1065|    592|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
 1066|    592|      E tmp(static_cast<E&&>(*e.error_ptr()));
 1067|    592|      e.error_ptr()->~E();
 1068|       |      // The rollback exists for the case where T's move CAN throw. In the
 1069|       |      // instantiation where it cannot, this function is noexcept (see the
 1070|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
 1071|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
 1072|       |      // so with `if constexpr` compiles the handler only where it can run,
 1073|       |      // which is what the code already meant.
 1074|       |#if METL_NO_EXCEPTIONS
 1075|       |      e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1076|       |#else
 1077|    592|      if constexpr (std::is_nothrow_move_constructible_v<T>) {
 1078|    592|        e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1079|       |      } else {
 1080|       |        try {
 1081|       |          e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1082|       |        } catch (...) {
 1083|       |          e.construct_error(static_cast<E&&>(tmp));  // restore e
