  169|    703|void replace_live(U* slot, expected_state& state, expected_state settled, Args&&... args) {
  170|       |  if constexpr (!std::is_move_constructible_v<U>) {
  171|       |    // Nothing can be built aside or set aside for a rollback -- std::expected::
  172|       |    // emplace rejects such a U outright; METL keeps accepting it, without the
  173|       |    // aliasing support or the guarantee.
  174|       |    state = expected_state::switching;
  175|       |    slot->~U();
  176|       |    ::new (static_cast<void*>(slot)) U(std::forward<Args>(args)...);
  177|       |    state = settled;
  178|    703|  } else if constexpr (std::is_nothrow_move_constructible_v<U> || METL_NO_EXCEPTIONS) {
  179|       |    // Only the constructor can throw, and it runs while the old value is intact.
  180|    703|    U incoming(std::forward<Args>(args)...);
  181|    703|    state = expected_state::switching;
  182|    703|    slot->~U();
  183|    703|    ::new (static_cast<void*>(slot)) U(static_cast<U&&>(incoming));
  184|    703|    state = settled;
  185|       |  }
  186|       |#if !METL_NO_EXCEPTIONS
  187|       |  else {
  188|       |    // The final move can throw: keep the old value in `backup` to move back.
  189|       |    U incoming(std::forward<Args>(args)...);
  190|       |    U backup(static_cast<U&&>(*slot));
  191|       |    state = expected_state::switching;
  192|       |    slot->~U();
  193|       |    try {
  194|       |      ::new (static_cast<void*>(slot)) U(static_cast<U&&>(incoming));
  195|       |    } catch (...) {
  196|       |      ::new (static_cast<void*>(slot)) U(static_cast<U&&>(backup));
  197|       |      state = settled;
  198|       |      throw;
  199|       |    }
  200|       |    state = settled;
  201|       |  }
  202|    703|#endif
  203|    703|}
