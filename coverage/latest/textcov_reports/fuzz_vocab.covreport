  223|       |    // Only the constructor can throw, and it runs while the old value is intact.
  224|  1.00k|    U incoming(std::forward<Args>(args)...);
  225|  1.00k|    state = expected_state::switching;
  226|  1.00k|    slot->~U();
  227|  1.00k|    ::new (static_cast<void*>(slot)) U(static_cast<U&&>(incoming));
  228|  1.00k|    state = settled;
