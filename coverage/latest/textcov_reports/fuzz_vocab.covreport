  990|    890|                                                                  std::is_nothrow_move_constructible_v<E>) {
  991|       |    // Both branches below end with one unguarded move. With one nothrow move a
  992|       |    // rollback is always possible; with two throwing moves the last step could
  993|       |    // fail after both originals are gone, leaving a destroyed member under a
  994|       |    // stale discriminant. std::expected::swap has the same
  995|       |    // requirement.
  996|    890|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
  997|    890|                  "metl::expected::swap requires T or E to be nothrow move constructible");
  998|       |    // Both read as switching until both members are in place again.
  999|    890|    v.state_ = detail::expected_state::switching;
 1000|    890|    e.state_ = detail::expected_state::switching;
 1001|    890|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
 1002|    890|      E tmp(static_cast<E&&>(*e.error_ptr()));
 1003|    890|      e.error_ptr()->~E();
 1004|       |      // The rollback exists for the case where T's move CAN throw. In the
 1005|       |      // instantiation where it cannot, this function is noexcept (see the
 1006|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
 1007|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
 1008|       |      // so with `if constexpr` compiles the handler only where it can run,
 1009|       |      // which is what the code already meant.
 1010|       |#if METL_NO_EXCEPTIONS
 1011|       |      ::new (e.storage_addr()) T(static_cast<T&&>(*v.value_ptr()));
 1012|       |#else
 1013|    890|      if constexpr (std::is_nothrow_move_constructible_v<T>) {
 1014|    890|        ::new (e.storage_addr()) T(static_cast<T&&>(*v.value_ptr()));
 1015|       |      } else {
 1016|       |        try {
 1017|       |          ::new (e.storage_addr()) T(static_cast<T&&>(*v.value_ptr()));
 1018|       |        } catch (...) {
 1019|       |          ::new (e.storage_addr()) E(static_cast<E&&>(tmp));  // restore e
 1020|       |          v.state_ = detail::expected_state::value;
 1021|       |          e.state_ = detail::expected_state::error;
 1022|       |          throw;
 1023|       |        }
 1024|       |      }
 1025|    890|#endif
 1026|    890|      v.value_ptr()->~T();
