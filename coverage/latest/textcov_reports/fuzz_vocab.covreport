  442|       |      try {
  443|       |        construct_value(std::forward<Args>(args)...);
  444|       |      } catch (...) {
  445|       |        construct_error(static_cast<E&&>(backup));  // restore the previous state
  446|       |        state_ = detail::expected_state::error;
  447|       |        throw;
  448|       |      }
  449|       |#endif
  450|       |    }
  451|    290|    state_ = detail::expected_state::value;
  452|    290|  }
