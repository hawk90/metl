 1048|    618|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1049|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1050|       |    // rollback is always possible; with two throwing moves the last step could
 1051|       |    // fail after both originals are gone, leaving a destroyed member under a
 1052|       |    // stale discriminant. std::expected::swap has the same
 1053|       |    // requirement.
 1054|    618|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1055|    618|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1056|       |    // Both read as switching until both members are in place again.
 1057|    618|    v.state_ = detail::expected_state::switching;
 1058|    618|    e.state_ = detail::expected_state::switching;
 1059|    618|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
 1060|    618|      E tmp(static_cast<E&&>(*e.error_ptr()));
 1061|    618|      e.error_ptr()->~E();
 1062|       |      // The rollback exists for the case where T's move CAN throw. In the
 1063|       |      // instantiation where it cannot, this function is noexcept (see the
 1064|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
 1065|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
 1066|       |      // so with `if constexpr` compiles the handler only where it can run,
 1067|       |      // which is what the code already meant.
 1068|       |#if METL_NO_EXCEPTIONS
 1069|       |      e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1070|       |#else
 1071|    618|      if constexpr (std::is_nothrow_move_constructible_v<T>) {
 1072|    618|        e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1073|       |      } else {
 1074|       |        try {
 1075|       |          e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1076|       |        } catch (...) {
 1077|       |          e.construct_error(static_cast<E&&>(tmp));  // restore e
