  797|  4.44k|      commit_value(static_cast<T&&>(incoming));
  798|       |    } else if constexpr (std::is_nothrow_constructible_v<T, Args&&...>) {
  799|       |      // A non-movable T cannot be built aside; aliasing the old member is a
