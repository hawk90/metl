 1048|    619|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1049|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1050|       |    // rollback is always possible; with two throwing moves the last step could
 1051|       |    // fail after both originals are gone, leaving a destroyed member under a
 1052|       |    // stale discriminant. std::expected::swap has the same
 1053|       |    // requirement.
 1054|    619|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1055|    619|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1056|       |    // Both read as switching until both members are in place again.
 1057|    619|    v.state_ = detail::expected_state::switching;
 1058|    619|    e.state_ = detail::expected_state::switching;
 1059|    619|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
