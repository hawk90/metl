  195|       |    } catch (...) {
  196|       |      ::new (static_cast<void*>(slot)) U(static_cast<U&&>(backup));
  197|       |      state = settled;
  198|       |      throw;
  199|       |    }
  200|       |    state = settled;
  201|       |  }
  202|  1.23k|#endif
