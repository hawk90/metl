  419|    290|  void reinit_as_value(Args&&... args) {
  420|    290|    if constexpr (std::is_move_constructible_v<T>) {
  421|       |      // Build the new value BEFORE touching the old member: `args` may refer
  422|       |      // into it (`e = e.error().fallback`), and destroying first would read a
  423|       |      // dead object.
  424|       |      // A throw here leaves the state untouched.
