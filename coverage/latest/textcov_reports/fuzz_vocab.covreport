 1215|    423|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1216|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1217|       |    // rollback is always possible; with two throwing moves the last step could
 1218|       |    // fail after both originals are gone, leaving a destroyed member under a
 1219|       |    // stale discriminant. std::expected::swap has the same
 1220|       |    // requirement.
 1221|    423|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1222|    423|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1223|       |    // Both read as switching until both members are in place again.
 1224|    423|    v.state_ = detail::expected_state::switching;
 1225|    423|    e.state_ = detail::expected_state::switching;
 1226|    423|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
