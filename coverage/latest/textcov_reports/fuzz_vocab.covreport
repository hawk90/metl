  792|       |    } else if constexpr (std::is_nothrow_constructible_v<T, Args&&...>) {
  793|       |      // A non-movable T cannot be built aside; aliasing the old member is a
  794|       |      // precondition violation here, as it is for std::expected.
  795|       |      error_ptr()->~E();
  796|       |      construct_value(std::forward<Args>(args)...);
  797|       |    } else {
  798|       |#if METL_NO_EXCEPTIONS
  799|       |      error_ptr()->~E();
  800|       |      construct_value(std::forward<Args>(args)...);
  801|       |#else
  802|       |      E backup(static_cast<E&&>(*error_ptr()));
