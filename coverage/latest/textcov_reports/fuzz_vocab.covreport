fuzz_vocab.cpp:_ZN4metl6detail12replace_liveIN12_GLOBAL__N_17payloadEJRKjEEEvPT_RNS0_14expected_stateES8_DpOT0_:
  213|    997|void replace_live(U* slot, expected_state& state, expected_state settled, Args&&... args) {
  214|       |  if constexpr (!std::is_move_constructible_v<U>) {
  215|       |    // Nothing can be built aside or set aside for a rollback -- std::expected::
  216|       |    // emplace rejects such a U outright; METL keeps accepting it, without the
  217|       |    // aliasing support or the guarantee.
  218|       |    state = expected_state::switching;
  219|       |    slot->~U();
  220|       |    ::new (static_cast<void*>(slot)) U(std::forward<Args>(args)...);
  221|       |    state = settled;
  222|    997|  } else if constexpr (std::is_nothrow_move_constructible_v<U> || METL_NO_EXCEPTIONS) {
  223|       |    // Only the constructor can throw, and it runs while the old value is intact.
  224|    997|    U incoming(std::forward<Args>(args)...);
  225|    997|    state = expected_state::switching;
  226|    997|    slot->~U();
  227|    997|    ::new (static_cast<void*>(slot)) U(static_cast<U&&>(incoming));
