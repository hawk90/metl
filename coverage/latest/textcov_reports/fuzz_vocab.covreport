  368|    599|void replace_live(U* slot, expected_state& state, expected_state settled, Args&&... args) {
  369|       |  if constexpr (!std::is_move_constructible_v<U>) {
  370|       |    // Nothing can be built aside or set aside for a rollback -- std::expected::
  371|       |    // emplace rejects such a U outright; METL keeps accepting it, without the
  372|       |    // aliasing support or the guarantee.
  373|       |    state = expected_state::switching;
  374|       |    slot->~U();
  375|       |    ::new (static_cast<void*>(slot)) U(std::forward<Args>(args)...);
  376|       |    state = settled;
  377|    599|  } else if constexpr (std::is_nothrow_move_constructible_v<U> || METL_NO_EXCEPTIONS) {
