  902|    945|                                                                  std::is_nothrow_move_constructible_v<E>) {
  903|       |    // Both branches below end with one unguarded move. With one nothrow move a
  904|       |    // rollback is always possible; with two throwing moves the last step could
  905|       |    // fail after both originals are gone, leaving a destroyed member under a
  906|       |    // stale discriminant. std::expected::swap has the same
  907|       |    // requirement.
  908|    945|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
  909|    945|                  "metl::expected::swap requires T or E to be nothrow move constructible");
  910|    945|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
  911|    945|      E tmp(static_cast<E&&>(*e.error_ptr()));
  912|    945|      e.error_ptr()->~E();
  913|       |      // The rollback exists for the case where T's move CAN throw. In the
  914|       |      // instantiation where it cannot, this function is noexcept (see the
  915|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
  916|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
  917|       |      // so with `if constexpr` compiles the handler only where it can run,
  918|       |      // which is what the code already meant.
  919|       |#if METL_NO_EXCEPTIONS
