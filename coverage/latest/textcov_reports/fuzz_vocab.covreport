 1216|    655|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1217|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1218|       |    // rollback is always possible; with two throwing moves the last step could
 1219|       |    // fail after both originals are gone, leaving a destroyed member under a
 1220|       |    // stale discriminant. std::expected::swap has the same
 1221|       |    // requirement.
 1222|    655|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1223|    655|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1224|       |    // Both read as switching until both members are in place again.
 1225|    655|    v.state_ = detail::expected_state::switching;
 1226|    655|    e.state_ = detail::expected_state::switching;
 1227|    655|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
 1228|    655|      E tmp(static_cast<E&&>(*e.error_ptr()));
 1229|    655|      e.error_ptr()->~E();
