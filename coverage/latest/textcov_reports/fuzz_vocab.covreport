 1037|    445|                                                                  std::is_nothrow_move_constructible_v<E>) {
 1038|       |    // Both branches below end with one unguarded move. With one nothrow move a
 1039|       |    // rollback is always possible; with two throwing moves the last step could
 1040|       |    // fail after both originals are gone, leaving a destroyed member under a
 1041|       |    // stale discriminant. std::expected::swap has the same
 1042|       |    // requirement.
 1043|    445|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
 1044|    445|                  "metl::expected::swap requires T or E to be nothrow move constructible");
 1045|       |    // Both read as switching until both members are in place again.
 1046|    445|    v.state_ = detail::expected_state::switching;
 1047|    445|    e.state_ = detail::expected_state::switching;
 1048|    445|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
 1049|    445|      E tmp(static_cast<E&&>(*e.error_ptr()));
 1050|    445|      e.error_ptr()->~E();
 1051|       |      // The rollback exists for the case where T's move CAN throw. In the
 1052|       |      // instantiation where it cannot, this function is noexcept (see the
 1053|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
 1054|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
 1055|       |      // so with `if constexpr` compiles the handler only where it can run,
 1056|       |      // which is what the code already meant.
 1057|       |#if METL_NO_EXCEPTIONS
 1058|       |      e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1059|       |#else
 1060|    445|      if constexpr (std::is_nothrow_move_constructible_v<T>) {
 1061|    445|        e.construct_value(static_cast<T&&>(*v.value_ptr()));
 1062|       |      } else {
 1063|       |        try {
 1064|       |          e.construct_value(static_cast<T&&>(*v.value_ptr()));
