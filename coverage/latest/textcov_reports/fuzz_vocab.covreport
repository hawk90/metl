  904|  5.75k|                                                                  std::is_nothrow_move_constructible_v<E>) {
  905|       |    // Both branches below end with one unguarded move. With one nothrow move a
  906|       |    // rollback is always possible; with two throwing moves the last step could
  907|       |    // fail after both originals are gone, leaving a destroyed member under a
  908|       |    // stale discriminant. std::expected::swap has the same
  909|       |    // requirement.
  910|  5.75k|    static_assert(std::is_nothrow_move_constructible_v<T> || std::is_nothrow_move_constructible_v<E>,
  911|  5.75k|                  "metl::expected::swap requires T or E to be nothrow move constructible");
  912|  5.75k|    if constexpr (std::is_nothrow_move_constructible_v<E>) {
  913|  5.75k|      E tmp(static_cast<E&&>(*e.error_ptr()));
  914|  5.75k|      e.error_ptr()->~E();
  915|       |      // The rollback exists for the case where T's move CAN throw. In the
  916|       |      // instantiation where it cannot, this function is noexcept (see the
  917|       |      // signature) and the handler is unreachable -- GCC reports exactly that as
  918|       |      // -Wterminate, since it sees a `throw` inside a noexcept function. Saying
  919|       |      // so with `if constexpr` compiles the handler only where it can run,
  920|       |      // which is what the code already meant.
