 1094|       |      v.value_ptr()->~T();
 1095|       |#if !METL_NO_EXCEPTIONS
 1096|       |      try {
 1097|       |#endif
 1098|       |        v.construct_error(static_cast<E&&>(*e.error_ptr()));
 1099|       |#if !METL_NO_EXCEPTIONS
 1100|       |      } catch (...) {
 1101|       |        v.construct_value(static_cast<T&&>(tmp));  // restore v
 1102|       |        v.state_ = detail::expected_state::value;
 1103|       |        e.state_ = detail::expected_state::error;
 1104|       |        throw;
 1105|       |      }
 1106|       |#endif
 1107|       |      e.error_ptr()->~E();
 1108|       |      e.construct_value(static_cast<T&&>(tmp));
