{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommitType": "ci",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on the first day of the month"
    ]
  },
  "nodenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Non-major updates: one weekly PR, auto-merged once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "GitHub Actions: group, automerge non-major",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates: listed on the Dependency Dashboard; a PR is opened only after ticking its checkbox",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pins, digest pins and lock-file maintenance carry no release timestamp, and Renovate >= 42 treats a missing timestamp as 'not old enough', so with minimumReleaseAge the renovate/stability-days status stays pending forever on those PRs (seen 2026-10-05..08). Exempt only these update types; real version updates still wait 3 days",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "clang-format: both pins are one dependency (one PyPI lookup), so they always move to the same version in one PR; CI also checks they agree",
      "matchPackageNames": [
        "clang-format"
      ],
      "groupName": "clang-format"
    },
    {
      "description": "Zephyr: the west release pinned in .github/zephyr/west.yml; the CI job derives the SDK version from it",
      "matchPackageNames": [
        "zephyrproject-rtos/zephyr"
      ],
      "groupName": "zephyr"
    },
    {
      "description": "Stay on the pinned LTS / release series: majors and minors of Zephyr and ESP-IDF need approval on the dashboard",
      "matchPackageNames": [
        "zephyrproject-rtos/zephyr",
        "espressif/idf"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "Zephyr release pinned in the west manifest of the zephyr CI job",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/zephyr/west\\.yml$/"
      ],
      "matchStrings": [
        "url: https://github\\.com/zephyrproject-rtos/zephyr\\s+revision: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "zephyrproject-rtos/zephyr",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "ESP-IDF Docker tag passed to espressif/esp-idf-ci-action",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "esp_idf_version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "espressif/idf",
      "datasourceTemplate": "docker"
    },
    {
      "description": "clang-format installed by the CI clang-format job; must move with the pre-commit pin",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "pipx install clang-format==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "clang-format",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Conan installed by the CI conan job (pipx)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "pipx install conan==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "conan",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "The pre-commit clang-format mirror, read from the SAME PyPI dependency as the CI pin so both always resolve to one version in one PR (the mirror's tags are the PyPI versions with a v)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "repo: https://github\\.com/pre-commit/mirrors-clang-format\\s+rev: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "clang-format",
      "datasourceTemplate": "pypi"
    }
  ]
}
