{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommitType": "ci",
  "timezone": "Asia/Seoul",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] },
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on the first day of the month"] },
  "nodenv": { "enabled": false },
  "packageRules": [
    {
      "description": "Non-major updates: one weekly PR, auto-merged once CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "GitHub Actions: group, automerge non-major",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates stay separate and manual",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
