{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommitType": "ci",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on the first day of the month"
    ]
  },
  "nodenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Non-major updates: one weekly PR, auto-merged once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "GitHub Actions: group, automerge non-major",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates: listed on the Dependency Dashboard; a PR is opened only after ticking its checkbox",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "clang-format: the pre-commit mirror and the CI pipx pin are one dependency and must land in one PR (.pre-commit-config.yaml says so)",
      "matchPackageNames": [
        "clang-format",
        "pre-commit/mirrors-clang-format",
        "https://github.com/pre-commit/mirrors-clang-format"
      ],
      "groupName": "clang-format"
    },
    {
      "description": "Zephyr: the west release and its cache key move together; the CI container (ghcr.io/zephyrproject-rtos/ci) is paired with the SDK and is reviewed by hand",
      "matchPackageNames": [
        "zephyrproject-rtos/zephyr"
      ],
      "groupName": "zephyr"
    },
    {
      "description": "Stay on the pinned LTS / release series: majors and minors of Zephyr and ESP-IDF need approval on the dashboard",
      "matchPackageNames": [
        "zephyrproject-rtos/zephyr",
        "espressif/idf"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Zephyr release pinned in the west init of the zephyr CI job",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "west init -m https://github\\.com/zephyrproject-rtos/zephyr --mr (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "zephyrproject-rtos/zephyr",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "Zephyr west cache key, kept in step with the release above",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "key: zephyr-west-(?<currentValue>v\\d+\\.\\d+\\.\\d+)-"
      ],
      "depNameTemplate": "zephyrproject-rtos/zephyr",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "ESP-IDF Docker tag passed to espressif/esp-idf-ci-action",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "esp_idf_version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "espressif/idf",
      "datasourceTemplate": "docker"
    },
    {
      "description": "clang-format installed by the CI clang-format job; must move with the pre-commit pin",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "pipx install clang-format==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "clang-format",
      "datasourceTemplate": "pypi"
    }
  ]
}
